<h1>Servicios</h1>

<ul id="services-list">
  {{#each services}}
    <li >
      <strong>{{this.name}}</strong> - {{this.category}}
      ({{this.duration}} min) - ${{this.price}} - {{this.description}}
      {{#if this.available}}Disponible{{else}}No disponible{{/if}}
    </li>
  {{else}}
    <li class="empty-message">No hay servicios cargados.</li>
  {{/each}}
</ul>

{{#if totalPages}}
<nav class="pagination">
  {{#if hasPrevPage}}<a href="{{prevUrl}}">&laquo; Anterior</a>{{/if}}
  <span>Página {{page}} de {{totalPages}}</span>
  {{#if hasNextPage}}<a href="{{nextUrl}}">Siguiente &raquo;</a>{{/if}}
</nav>
{{/if}}
